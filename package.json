{
  "name": "malla-curricular-fing",
  "version": "1.0.0",
  "private": true,
  "description": "Malla curricular interactiva para estudiantes de FING.",
  "scripts": {
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "security:static": "eslint assets/js scripts index.html --max-warnings 0",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "eslint": "10.15.0",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "jest": "^29.7.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests-e2e/"
    ]
  }
}
